<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Barcode Scanner + Flashlight</title>

  <script src="https://unpkg.com/html5-qrcode"></script>

  <style>
    body {
      font-family: Arial;
      text-align: center;
      padding: 15px;
    }

    #reader {
      width: 100%;
      max-width: 500px;
      margin: auto;
    }

    button {
      padding: 12px 20px;
      margin: 8px;
      border: none;
      border-radius: 8px;
      font-size: 16px;
    }

    #flashBtn {
      background: #222;
      color: white;
    }

    #result {
      font-size: 20px;
      color: green;
      word-break: break-all;
    }
  </style>
</head>

<body>

  <h2>📷 Barcode Scanner</h2>

  <div id="reader"></div>

  <button id="flashBtn" onclick="toggleFlash()">
    🔦 Flashlight OFF
  </button>

  <p>
    Result:
    <strong id="result">Wala pa</strong>
  </p>

  <script>

    let scanner;
    let cameraTrack = null;
    let flashlightOn = false;

    function onScanSuccess(decodedText, decodedResult) {

      document.getElementById("result").textContent = decodedText;

      console.log("Barcode:", decodedText);
    }

    function onScanFailure(error) {
      // Normal lang habang naghahanap ng barcode
    }

    scanner = new Html5QrcodeScanner(
      "reader",
      {
        fps: 10,
        qrbox: {
          width: 250,
          height: 150
        }
      },
      false
    );

    scanner.render(
      onScanSuccess,
      onScanFailure
    );


    async function toggleFlash() {

      try {

        const video = document.querySelector("#reader video");

        if (!video) {
          alert("Hintayin munang mag-start ang camera.");
          return;
        }

        cameraTrack = video.srcObject?.getVideoTracks()[0];

        if (!cameraTrack) {
          alert("Hindi makita ang camera.");
          return;
        }

        const capabilities = cameraTrack.getCapabilities();

        if (!capabilities.torch) {
          alert("Hindi supported ng browser o camera ang flashlight control.");
          return;
        }

        flashlightOn = !flashlightOn;

        await cameraTrack.applyConstraints({
          advanced: [
            {
              torch: flashlightOn
            }
          ]
        });

        document.getElementById("flashBtn").textContent =
          flashlightOn
            ? "🔦 Flashlight ON"
            : "🔦 Flashlight OFF";

      } catch (error) {

        console.error(error);

        alert("Hindi ma-control ang flashlight sa device na ito.");

      }

    }

  </script>

</body>
</html>